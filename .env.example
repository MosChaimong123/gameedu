# --- MongoDB (Prisma datasource in prisma/schema.prisma) ---
DATABASE_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/DATABASE?retryWrites=true&w=majority"

# Render: ดู render.yaml (build + preDeploy prisma db push). คัดลอกค่าส่วนใหญ่ไปใส่ Dashboard → Environment

# Public URL of the app (no trailing slash).
# Online (Render, etc.): MUST be the HTTPS URL from the dashboard (e.g. https://gamedu-app.onrender.com).
# Never use 0.0.0.0, internal PORT only, or localhost — Google OAuth redirects will break for real users.
# Local dev: http://localhost:PORT only (not 0.0.0.0).
NEXT_PUBLIC_APP_URL="https://your-app-name.onrender.com"

# Next Auth / Auth.js — must match NEXT_PUBLIC_APP_URL (same public origin, no trailing slash).
NEXTAUTH_URL="https://your-app-name.onrender.com"
NEXTAUTH_SECRET="your-super-secret-key"
AUTH_SECRET="your-super-secret-key"
# Required behind Render / reverse proxy (also set in render.yaml)
AUTH_TRUST_HOST="true"

# Google OAuth — optional; if both are unset or empty, only credentials login is used
GOOGLE_CLIENT_ID="xxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxx"

# Email verification + password recovery (Resend) — optional in dev; required for production readiness.
# Production must use a sender on a domain verified in Resend. `@resend.dev` is rejected.
# RESEND_API_KEY="re_..."
  # RESEND_WEBHOOK_SECRET="whsec_..."
  # PASSWORD_RESET_DELIVERY_ALERT_WINDOW_MINUTES="60"
  # PASSWORD_RESET_DELIVERY_ALERT_MIN_SAMPLE="10"
  # PASSWORD_RESET_DELIVERY_ALERT_FAILURE_PERCENT="20"
  # EMAIL_DELIVERY_RETENTION_DAYS="90"
  # AUDIT_LOG_RETENTION_DAYS="365"
  # EMAIL_FROM="TeachPlayEdu <notify@yourdomain.com>"
  # Dedicated random secret, at least 32 characters. Do not reuse or expose it to the browser.
  # EMAIL_VERIFICATION_PEPPER="generate-a-strong-random-secret"
#
# Signup / email verification (production on Render sets these via render.yaml)
# ENABLE_PUBLIC_SIGNUP="true"
# NEXT_PUBLIC_ENABLE_PUBLIC_SIGNUP="true"
# REQUIRE_EMAIL_VERIFICATION="true"
# DISABLE_PUBLIC_SIGNUP="false"
# NEXT_PUBLIC_DISABLE_PUBLIC_SIGNUP="false"
# SKIP_EMAIL_VERIFICATION="false"
# NEXT_PUBLIC_SKIP_EMAIL_VERIFICATION="false"

# Live Negamon Battle from host / classroom launcher (unset or not "true" = disabled).
# NEXT_PUBLIC_NEGAMON_BATTLE_HOST_ENABLED="true"
#
# Classroom gamification (rank / events / Negamon settings). Default on; set false to show "coming soon".
# NEXT_PUBLIC_CLASSROOM_GAMIFICATION_ENABLED="true"

# Teacher OMR (dashboard / scanner / templates). Unset or not "true" = hidden ("เร็วๆนี้" on dashboard); set to enable.
# NEXT_PUBLIC_OMR_DASHBOARD_ENABLED="true"

# Socket.io (browser connects here; same origin as the app on Render)
NEXT_PUBLIC_SOCKET_URL="https://your-app-name.onrender.com"
# Production: allowed origins (defaults to NEXTAUTH_URL / NEXT_PUBLIC_APP_URL if unset). Dev uses reflected origin.
# A single HTTPS apex or www URL is expanded server-side to include its www/apex pair (e.g. teachplayedu.com <-> www.teachplayedu.com).
# For two unrelated domains, use a comma-separated list (no trailing slashes):
# SOCKET_IO_CORS_ORIGIN="https://www.example.com,https://other.example.com"
# SOCKET_IO_CORS_ORIGIN="https://your-app-name.onrender.com"

# Optional: Port (Render sets PORT automatically)
PORT=3000
# auto: production uses Mongo for shared rate limits; dev/test use memory
RATE_LIMIT_STORE="auto"
AUDIT_LOG_SINK="auto"
HEALTHCHECK_DB_TIMEOUT_MS=3000

# Admin secret (required to create an ADMIN account)
ADMIN_SECRET="your-admin-secret-key-here"

# Board / classroom file uploads (Cloudflare R2 — recommended on Render)
# UPLOAD_STORAGE: unset | auto (use R2 when env complete) | local | r2
# UPLOAD_STORAGE="auto"
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME=""
# R2_PUBLIC_BASE_URL="https://pub-xxxx.r2.dev"

# AI (optional — generate-questions API)
# GEMINI_API_KEY="..."

# Optional quiz review default: end_only | never
# QUIZ_REVIEW_MODE="end_only"

# --- Stripe billing (PLUS subscription self-serve) ---
# Copy actual values into .env.local (gitignored). Use Price IDs (price_...) from each price row — not Product ID (prod_...).
# Create Products/Prices in Stripe Dashboard; paste Price IDs (price_...) below.
# STRIPE_SECRET_KEY="sk_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_..." # optional until using Stripe.js
# STRIPE_PRICE_PLUS_MONTHLY="price_..."
# STRIPE_PRICE_PLUS_YEARLY="price_..."
# Local webhooks: ใส่ STRIPE_SECRET_KEY แล้วรัน npm run billing:stripe-listen (ไม่ต้อง stripe login)
# เอา whsec ใส่ STRIPE_WEBHOOK_SECRET: npm run billing:stripe-print-secret
#
# Stripe PromptPay (Thailand, hosted Checkout — QR like insKru):
# - Enable in Stripe Dashboard → Settings → Payment methods → PromptPay (live account, TH business).
# - Upgrade page: card = subscription (auto-renew); PromptPay = one-time pass (month = 30 days, year = 12 months).
# - Webhook endpoint must include: checkout.session.async_payment_succeeded (and existing subscription events).
# - Production: leave BILLING_THAI_PROVIDER unset or set to none (Omise removed; Stripe only).
#
# Dev-only mock Thai billing (optional; not shown on /dashboard/upgrade in production):
# BILLING_THAI_PROVIDER: unset | none | mock
# BILLING_THAI_WEBHOOK_SECRET: Bearer for POST /api/webhooks/billing/mock
# BILLING_THAI_PROVIDER="mock"
# BILLING_THAI_WEBHOOK_SECRET="dev-only-secret"

# --- LINE Bot (group debt reminder MVP) ---
# Create a Messaging API channel at https://developers.line.biz/
# Webhook URL: {NEXT_PUBLIC_APP_URL}/api/webhooks/line
# LINE_CHANNEL_SECRET="..."
# LINE_CHANNEL_ACCESS_TOKEN="..."
# LINE_BOT_ENABLED="true"
# Dedicated 32+ character secret used to encrypt queued webhook payloads.
# LINE_WEBHOOK_INBOX_SECRET="generate-a-dedicated-random-secret"
# LINE_WEBHOOK_RETENTION_DAYS="30"
# LINE_DELIVERY_RETENTION_DAYS="90"
# Security containment: set true only after the Prisma schema is deployed and
# every teacher using group commands has verified their LINE identity.
# Student direct-chat commands remain available while this stays false.
# LINE_GROUP_MUTATIONS_ENABLED="false"
# Rollback controls (unset = enabled except group mutations).
# LINE_WEBHOOK_ACCEPTING_ENABLED="true"
# LINE_REMINDER_DELIVERY_ENABLED="true"
# LINE_DIRECT_SUBMISSIONS_ENABLED="true"
# Optional comma-separated classroom ObjectIds for a staged pilot.
# LINE_PILOT_CLASSROOM_IDS=""
# Dedicated credential for /api/jobs/line-reminders. Never reuse ADMIN_SECRET.
# LINE_REMINDER_CRON_SECRET="..."
# Public HTTPS URL for opening a direct chat with the LINE bot.
# NEXT_PUBLIC_LINE_BOT_URL="https://line.me/R/ti/p/@your-bot"

# --- Sentry (observability) ---
# All variables are optional in dev (SDK is a no-op without DSN). In production set them
# on Render → Environment so production errors / 500s ship to Sentry instead of being lost.
# DSN is the same string for server + client (NEXT_PUBLIC_SENTRY_DSN must mirror SENTRY_DSN
# so the browser bundle can transport client-side errors).
# SENTRY_DSN="https://<key>@oXXXX.ingest.us.sentry.io/<project>"
# NEXT_PUBLIC_SENTRY_DSN="https://<key>@oXXXX.ingest.us.sentry.io/<project>"
# SENTRY_AUTH_TOKEN="sntrys_..."          # Personal/CI token w/ project:releases — required to upload source maps during build
# SENTRY_ORG="teachplayedu"
# SENTRY_PROJECT="gameedu-prod"
# SENTRY_ENVIRONMENT="production"          # falls back to NODE_ENV
# NEXT_PUBLIC_SENTRY_ENVIRONMENT="production"
# SENTRY_RELEASE=""                        # Render commit SHA recommended; leave unset to skip release tagging
# SENTRY_TRACES_SAMPLE_RATE="0.05"         # 0..1; 0.05 = 5% of requests sampled for performance traces
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.05"
